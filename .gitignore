node_modules/
.cache/
*.log

# État de la veille : local, régénéré à chaque passage, pas de valeur en dépôt
data/.veille-state.json

# Bundle du POC : ~1 Mo régénéré à chaque collecte (node app/build-data.js).
# Le committer ferait 1 Mo de diff par passage, pour zéro information nouvelle :
# tout son contenu vient de data/*.json et app/departements.geojson, déjà versionnés.
app/data.js

# Socle du flux : régénéré par `npm run socle` à partir de data/*.json, tous
# versionnés. Le committer dupliquerait ~50 Ko de donnée déjà présente, et
# ferait diverger deux copies du même fait le jour où l'une est éditée à la main.
data/socle.json

# Sortie du cron PHP + copie locale du socle servant aux tests de server/cron.php.
# Le contrat public, c'est ce fichier-là — mais il est PRODUIT sur le serveur,
# pas versionné : le commiter publierait un bulletin figé qui vieillit en silence.
server/data/

# Credentials de déploiement. La config vit normalement dans le sibling
# ../Julienweb.fr-public/ — cette ligne est un filet de sécurité au cas où une
# copie atterrirait ici. Un mot de passe FTP commité est un mot de passe brûlé.
.deploy-ftp.json

# Correspondance en préparation. Ce sont des brouillons NON ENVOYÉS, adressés à
# des tiers nommés (agent public, association). Le dépôt étant public depuis le
# 28/07/2026, ils n'y ont pas leur place : publier sa stratégie de démarche avant
# de l'avoir engagée dessert la démarche, et sème des adresses nominatives dans
# un dépôt moissonnable. Ils restent sur le disque, versionnés par Drive.
mails/

# Google Drive
.tmp.drivedownload/
.tmp.driveupload/
desktop.ini
