# tout son contenu vient de data/*.json et app/departements.geojson, déjà versionnés.
app/data.js

# Credentials de déploiement. La config vit normalement dans le sibling
# ../Julienweb.fr-public/ — cette ligne est un filet de sécurité au cas où une
# copie atterrirait ici. Un mot de passe FTP commité est un mot de passe brûlé.
.deploy-ftp.json

# Correspondance en préparation. Ce sont des brouillons NON ENVOYÉS, adressés à
